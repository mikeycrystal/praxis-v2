{
  "cli": {
    "version": ">= 15.0.12",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "node": "20.19.4",
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_RECOMMENDER_API_URL": "https://praxis-backend-production.up.railway.app",
        "EXPO_PUBLIC_DISABLE_LIVE_RECOMMENDER": "false",
        "EXPO_PUBLIC_ENABLE_AI_RECOMMENDATIONS": "true"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6742516634"
      }
    }
  }
}